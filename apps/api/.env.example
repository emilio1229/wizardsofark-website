NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://woa:woa@localhost:5432/woa?schema=public

# CORS — comma-separated origins, or * for all
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# ASA discovery
ARK_API_URL=https://cdn2.arkdedicated.com/servers/asa/unofficialserverlist.json
SERVER_NAME_FILTER=The Wizards Of Ark

# Polling (ms) & status thresholds (seconds)
ARK_SERVER_POLL_INTERVAL=60000
RESTARTING_THRESHOLD_SECONDS=180
OFFLINE_THRESHOLD_SECONDS=600
CACHE_TTL_SECONDS=45
ASA_FETCH_TIMEOUT_MS=30000
MASTER_LIST_STALE_SECONDS=180

# Map display order (comma-separated friendly names)
MAP_ORDER=The Island,Scorched Earth,Aberration,Extinction,Ragnarok,Valguero,Genesis Part 1,Genesis Part 2,The Center,Lost Colony,Astraeos,Dragontopia,Amissa,Bjarnheim

# Optional Redis (not required — in-memory stores used by default)
REDIS_URL=
