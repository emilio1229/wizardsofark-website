generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  discordId String?    @unique
  username  String?
  email     String?
  roleId    String?    @db.Uuid
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  role                Role?         @relation(fields: [roleId], references: [id])
  createdInvitations  Invitation[]  @relation("InvitationCreator")
  receivedInvitations Invitation[]  @relation("InvitationUser")
  sessions            AuthSession[]

  @@index([roleId])
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  invitations Invitation[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  roleId    String    @db.Uuid
  createdBy String    @db.Uuid
  userId    String?   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  role    Role  @relation(fields: [roleId], references: [id])
  creator User  @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  user    User? @relation("InvitationUser", fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([createdBy])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ArkMap {
  id          String   @id
  name        String
  displayName String
  imagePath   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArkServer {
  id             String    @id
  sessionId      String?
  name           String
  sessionName    String?
  mapName        String?
  mapDisplayName String
  mapId          String
  ip             String
  gamePort       Int
  queryPort      Int?
  firstSeen      DateTime
  lastSeen       DateTime?
  lastChecked    DateTime
  currentStatus  String
  previousStatus String?
  players        Int?
  maxPlayers     Int?
  version        String?
  ping           Int?
  clusterId      String?
  isPve          Boolean?
  missingSince   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transitions StatusTransition[]
  snapshots   ServerSnapshot[]

  @@index([currentStatus])
  @@index([mapId])
  @@index([lastChecked])
}

model StatusTransition {
  id         Int      @id @default(autoincrement())
  serverId   String
  fromStatus String?
  toStatus   String
  observedAt DateTime
  note       String?

  server ArkServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model ServerSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  serverId   String
  players    Int?
  maxPlayers Int?
  status     String
  capturedAt DateTime @default(now())

  server ArkServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, capturedAt])
}

model CouncilMember {
  id               String   @id
  name             String
  title            String
  role             String
  tagline          String?
  avatar           String?
  portrait         String?
  energyColor      String?
  bio              String?
  responsibilities Json?
  accessLevel      String?
  status           String?
  quote            String?
  angle            Float?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ApplicationSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PollMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
