# Root / shared examples. Prefer apps/api/.env and apps/web/.env for local work.

# --- apps/web (Vite) ---
VITE_API_URL=/api/v1
VITE_WS_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_EOS_SHOP=false
VITE_FEATURE_ACCOUNT=true
VITE_AUTH_LOCAL_BYPASS=false

# --- apps/api ---
# Authoritative list lives in apps/api/.env.example; key vars only.
# NODE_ENV=development
# PORT=3001
# DATABASE_URL=postgresql://woa:woa@localhost:5432/woa?schema=public
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGIN=*
# ARKSTATUS_BASE_URL=https://arkstatus.com/api/v1
# ARKSTATUS_API_KEY=
# SERVER_NAME_FILTER=The Wizards Of Ark
# ARK_SERVER_POLL_INTERVAL=60000
# SERVER_RETENTION_DAYS=5
# REDIS_URL=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback
# AUTH_ADMIN_DISCORD_IDS=
