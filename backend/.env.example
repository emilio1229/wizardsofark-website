PORT=3001
HOST=0.0.0.0

# ASA discovery
ASA_SERVER_LIST_URL=https://cdn2.arkdedicated.com/servers/asa/unofficialserverlist.json
SERVER_NAME_FILTER=The Wizards Of Ark

# Polling & status thresholds (seconds)
POLL_INTERVAL_SECONDS=60
RESTARTING_THRESHOLD_SECONDS=180
OFFLINE_THRESHOLD_SECONDS=600
CACHE_TTL_SECONDS=45
ASA_FETCH_TIMEOUT_MS=30000
MASTER_LIST_STALE_SECONDS=180

# Persistence
DATABASE_PATH=../data/woa-servers.sqlite

# Optional: serve the Vite build from this process in production
STATIC_DIR=
CORS_ORIGIN=*

# Map display order (comma-separated friendly names)
MAP_ORDER=The Island,Scorched Earth,Aberration,Extinction,Ragnarok,Valguero,Genesis Part 1,Genesis Part 2,The Center,Lost Colony,Astraeos,Dragontopia,Amissa,Bjarnheim
