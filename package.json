{
  "name": "wizards-of-ark",
  "version": "2.0.0",
  "private": true,
  "description": "Wizards of Ark — monorepo (web + NestJS API)",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @woa/web dev",
    "dev:api": "yarn workspace @woa/api start:dev",
    "dev:all": "yarn build:shared && concurrently -k -n api,web -c blue,magenta \"yarn dev:api\" \"yarn dev\"",
    "build:shared": "yarn workspace @woa/shared build",
    "build:web": "yarn workspace @woa/web build",
    "build:api": "yarn workspace @woa/api build",
    "build": "yarn build:shared && yarn build:api && yarn build:web",
    "start": "yarn workspace @woa/api start:prod",
    "test": "yarn workspace @woa/api test",
    "test:api": "yarn workspace @woa/api test",
    "lint": "echo \"Add ESLint workspaces next\"",
    "prisma:generate": "yarn workspace @woa/api prisma:generate",
    "prisma:migrate": "yarn workspace @woa/api prisma:migrate",
    "prisma:seed": "yarn workspace @woa/api prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
