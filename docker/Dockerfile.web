# Vite SPA → Nginx (listens on $PORT; proxies /api + /socket.io when API_UPSTREAM is set)
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json yarn.lock ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN yarn install --frozen-lockfile --production=false
COPY packages/shared packages/shared
COPY apps/web apps/web
ARG VITE_API_URL=/api/v1
ARG VITE_WS_URL=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
RUN yarn workspace @woa/shared build && yarn workspace @woa/web build

FROM nginx:stable-alpine
COPY docker/nginx.web.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# Compose maps host 8080 → container; Railway injects its own PORT.
ENV PORT=8080
ENV API_UPSTREAM=127.0.0.1:3001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["nginx", "-g", "daemon off;"]
